datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Todo {
  id          String    @id @default(uuid())
  clerkUserId String
  title       String
  description String?
  dueDate     DateTime?
  allDay      Boolean   @default(false)
  completed   Boolean   @default(false)
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clerkUserId])
  @@index([clerkUserId, dueDate])
}

model Event {
  id          String   @id @default(uuid())
  clerkUserId String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  location    String?
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId])
  @@index([clerkUserId, startDate])
}

model TimeChunk {
  id          String   @id @default(uuid())
  clerkUserId String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  category    String   @default("FOCUS") // FOCUS, WORK, STUDY, MEETING, BREAK, EXERCISE, OTHER
  color       String   @default("#8B5CF6")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId])
  @@index([clerkUserId, startTime])
}
