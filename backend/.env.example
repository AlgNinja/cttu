# Server Port
PORT=5000

# PostgreSQL Connection String (matches docker-compose.yml or Supabase pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cttu_db?schema=public"
# Direct connection for Prisma migrations (matches DATABASE_URL locally, or Supabase port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cttu_db?schema=public"

# Clerk Authentication Keys (replace with your Clerk dashboard keys)
CLERK_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_CLERK_SECRET_KEY"
CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY"

# Allowed Frontend Origins (comma separated if multiple)
CORS_ORIGIN="http://localhost:5173"
